2. Codice aggiornato dell'Area Cliente (index.html)
Sostituisci il file index.html con questo codice. Ora legge automaticamente i dati dal file data.json o dall'URL (es. index.html?id=1 per Marco Rossi, index.html?id=2 per Giuseppe Bianchi):

HTML
<!DOCTYPE html>
<html lang="it">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>NAUTICOVI - Guest Portal</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
</head>
<body class="bg-slate-100 text-slate-800 pb-20">

    <!-- Header Brand -->
    <header class="bg-slate-900 text-white p-6 text-center shadow-xl border-b-4 border-cyan-500 sticky top-0 z-50">
        <div class="flex flex-col items-center justify-center">
            <i class="fa-solid fa-water text-cyan-400 text-2xl mb-1"></i>
            <h1 class="text-2xl font-black tracking-widest text-white">NAUTICOVI</h1>
            <p class="text-[10px] tracking-widest text-cyan-400 font-bold uppercase">Noleggio Barche • Praia a Mare</p>
        </div>
    </header>

    <main class="max-w-md mx-auto p-4 space-y-5">

        <!-- Banner Benvenuto Personalizzato -->
        <div class="bg-gradient-to-r from-slate-900 via-slate-800 to-cyan-900 rounded-2xl p-5 text-white shadow-lg border border-cyan-500/30">
            <div class="flex justify-between items-start">
                <div>
                    <span class="bg-cyan-500/20 text-cyan-300 text-xs px-2.5 py-1 rounded-full font-semibold border border-cyan-400/30">Noleggio Attivo</span>
                    <h2 class="text-xl font-extrabold mt-2" id="welcome-nome">Benvenuto a Bordo!</h2>
                    <p class="text-xs text-slate-300 mt-0.5">Barca: <span class="font-bold text-cyan-300" id="welcome-barca">Selezionata</span></p>
                </div>
                <a href="tel:+393000000000" class="bg-red-500 hover:bg-red-600 text-white p-3 rounded-xl shadow-lg transition flex items-center justify-center">
                    <i class="fa-solid fa-phone-volume text-lg"></i>
                </a>
            </div>
            <div class="mt-4 pt-3 border-t border-slate-700/60 flex justify-between items-center text-xs text-slate-300">
                <div class="flex items-center gap-2">
                    <i class="fa-solid fa-sun text-amber-400 text-base"></i>
                    <span>28°C • Mare Calmo</span>
                </div>
                <div class="flex items-center gap-1.5 text-cyan-300 font-medium">
                    <i class="fa-solid fa-wind"></i> Vento NO 6 nodi
                </div>
            </div>
        </div>

        <!-- Navigazione a Schede -->
        <div class="flex bg-slate-200 p-1 rounded-xl text-xs font-bold text-slate-600 gap-1 shadow-inner">
            <button onclick="switchTab('mappa')" id="tab-mappa" class="tab-btn flex-1 py-2.5 rounded-lg bg-white text-slate-900 shadow">Mappa & POI</button>
            <button onclick="switchTab('guida')" id="tab-guida" class="tab-btn flex-1 py-2.5 rounded-lg hover:text-slate-900">Guida Barca</button>
            <button onclick="switchTab('regole')" id="tab-regole" class="tab-btn flex-1 py-2.5 rounded-lg hover:text-slate-900">Regole Mare</button>
        </div>

        <!-- SEZIONE 1: MAPPA -->
        <div id="sec-mappa" class="tab-content space-y-4">
            <div class="bg-white p-4 rounded-2xl shadow-md border border-slate-200">
