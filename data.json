        </div>

    </div>

    <script>
        let clienti = JSON.parse(localStorage.getItem('nauticovi_clienti')) || [];

        function renderTable() {
            const tbody = document.getElementById('clientiTable');
            tbody.innerHTML = '';
            if(clienti.length === 0) {
                tbody.innerHTML = `<tr><td colspan="6" class="p-4 text-center text-slate-400">Nessun cliente registrato. Inseriscine uno dal form a sinistra!</td></tr>`;
                return;
            }
            clienti.forEach((c, index) => {
                tbody.innerHTML += `
                    <tr class="hover:bg-slate-50">
                        <td class="p-2.5 font-bold">${c.nome}<br><span class="font-normal text-slate-400">${c.email}</span></td>
                        <td class="p-2.5 font-mono">${c.cf_piva}</td>
                        <td class="p-2.5">${c.barca}</td>
                        <td class="p-2.5">${c.data_noleggio}</td>
                        <td class="p-2.5 font-bold text-emerald-600">€${c.importo}</td>
                        <td class="p-2.5">
                            <button onclick="eliminaCliente(${index})" class="text-red-500 hover:text-red-700 font-bold"><i class="fa-solid fa-trash"></i></button>
                        </td>
                    </tr>
                `;
            });
        }

        document.getElementById('crmForm').addEventListener('submit', function(e) {
            e.preventDefault();
            const nuovo = {
                nome: document.getElementById('nome').value,
                cf_piva: document.getElementById('cf_piva').value,
                telefono: document.getElementById('telefono').value,
                email: document.getElementById('email').value,
                barca: document.getElementById('barca').value,
                importo: document.getElementById('importo').value,
                data_noleggio: document.getElementById('data_noleggio').value
            };
            clienti.push(nuovo);
            localStorage.setItem('nauticovi_clienti', JSON.stringify(clienti));
            renderTable();
            this.reset();
        });

        function eliminaCliente(index) {
            clienti.splice(index, 1);
            localStorage.setItem('nauticovi_clienti', JSON.stringify(clienti));
            renderTable();
        }

        function exportCSV() {
            if(clienti.length === 0) {
                alert("Nessun dato da esportare!");
                return;
            }
            let csv = "Nome,CodiceFiscale_PIVA,Email,Telefono,Descrizione,Importo,Data\n";
            clienti.forEach(c => {
                csv += `"${c.nome}","${c.cf_piva}","${c.email}","${c.telefono}","Noleggio barca ${c.barca}",${c.importo},"${c.data_noleggio}"\n`;
            });
            const blob = new Blob([csv], { type: 'text/csv' });
            const url = window.URL.createObjectURL(blob);
            const a = document.createElement('a');
            a.setAttribute('href', url);
            a.setAttribute('download', 'import_fatture_in_cloud_nauticovi.csv');
            a.click();
        }

        renderTable();
    </script>
</body>
</html>
