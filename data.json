    <script>
        // Tab System
        function switchTab(tab) {
            document.querySelectorAll('.tab-content').forEach(el => el.classList.add('hidden'));
            document.querySelectorAll('.tab-btn').forEach(el => {
                el.classList.remove('bg-white', 'text-slate-900', 'shadow');
                el.classList.add('hover:text-slate-900');
            });

            document.getElementById('sec-' + tab).classList.remove('hidden');
            document.getElementById('tab-' + tab).classList.add('bg-white', 'text-slate-900', 'shadow');

            if(tab === 'mappa') {
                setTimeout(() => map.invalidateSize(), 200);
            }
        }

        // Map Setup
        const map = L.map('map').setView([39.8700, 15.7750], 13);
        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', { attribution: '© OpenStreetMap' }).addTo(map);

        const poiList = [
            { nome: 'Isola di Dino & Grotta Azzurra', desc: 'Acque cristalline e rifrazioni blu.', lat: 39.8731, lng: 15.7735 },
            { nome: 'Grotta del Leone', desc: 'Roccia caratteristica a leone.', lat: 39.8695, lng: 15.7720 },
            { nome: 'Arco Magno (San Nicola Arcella)', desc: 'Arco naturale e spiaggia incantata.', lat: 39.8456, lng: 15.7889 }
        ];

        poiList.forEach(poi => {
            L.marker([poi.lat, poi.lng]).addTo(map).bindPopup(`<b>${poi.nome}</b><br><span style="font-size:11px">${poi.desc}</span>`);
        });
    </script>
