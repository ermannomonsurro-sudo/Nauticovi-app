                <li class="flex items-start gap-2">
                    <i class="fa-solid fa-circle-check text-emerald-500 mt-0.5"></i>
                    <span><b>Isola di Dino:</b> Entrare nelle grotte solo a remi o a motore al minimo dove consentito.</span>
                </li>
                <li class="flex items-start gap-2">
                    <i class="fa-solid fa-triangle-exclamation text-amber-500 mt-0.5"></i>
                    <span><b>Ancoraggio:</b> Non gettare l'ancora sulle praterie di Posidonia.</span>
                </li>
            </ul>
        </div>

    </main>

    <script>
        // Mappa centrata sull'Isola di Dino (Praia a Mare)
        const map = L.map('map').setView([39.8731, 15.7735], 14);

        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
            attribution: '© OpenStreetMap'
        }).addTo(map);

        // Marker Isola di Dino
        L.marker([39.8731, 15.7735]).addTo(map)
            .bindPopup('<b>Isola di Dino</b><br>Grotta Azzurra e Grotta del Leone.');

        // Marker Arco Magno
        L.marker([39.8456, 15.7889]).addTo(map)
            .bindPopup('<b>Arco Magno</b><br>Spettacolare baia naturale.');
    </script>
</body>
