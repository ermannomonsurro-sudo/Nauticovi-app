    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>NAUTICOVI - Guest Portal</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
</head>
<body class="bg-slate-100 text-slate-800 pb-16">

    <!-- Header Brand con Logo Ufficiale -->
    <header class="bg-slate-900 text-white py-5 px-4 text-center shadow-xl border-b-4 border-cyan-500 sticky top-0 z-50">
        <div class="flex flex-col items-center justify-center">
            <!-- Icona Nautica e Titolo Maiuscolo -->
            <div class="flex items-center gap-2 mb-1">
                <i class="fa-solid fa-water text-cyan-400 text-2xl"></i>
                <h1 class="text-2xl font-black tracking-widest text-white">NAUTICOVI</h1>
            </div>
            <p class="text-[9px] tracking-widest text-cyan-400 font-bold uppercase">NOLEGGIO BARCHE • PRAIA A MARE</p>
        </div>
    </header>

    <main class="max-w-md mx-auto p-4 space-y-5">

        <!-- Banner Benvenuto Personalizzato -->
        <div class="bg-gradient-to-r from-slate-900 via-slate-800 to-cyan-900 rounded-2xl p-5 text-white shadow-lg border border-cyan-500/30">
            <div class="flex justify-between items-start">
                <div>
                    <span class="bg-cyan-500/20 text-cyan-300 text-xs px-2.5 py-1 rounded-full font-semibold border border-cyan-400/30">Noleggio Attivo</span>
                    <h2 class="text-xl font-extrabold mt-2" id="welcome-nome">Benvenuto a Bordo!</h2>
                    <p class="text-xs text-slate-300 mt-0.5">Barca: <span class="font-bold text-cyan-300" id="welcome-barca">Marlin 1</span></p>
                </div>
                <a href="tel:+393000000000" class="bg-red-500 hover:bg-red-600 text-white p-3 rounded-xl shadow-lg transition flex items-center justify-center">
                    <i class="fa-solid fa-phone-volume text-lg"></i>
                </a>
            </div>
            <!-- Widget Meteo e Vento -->
            <div class="mt-4 pt-3 border-t border-slate-700/60 flex justify-between items-center text-xs text-slate-300">
                <div class="flex items-center gap-2">
                    <i class="fa-solid fa-sun text-amber-400 text-base"></i>
                    <span>28°C • Mare Calmo</span>
                </div>
                <div class="flex items-center gap-1.5 text-cyan-300 font-medium">
                    <i class="fa-solid fa-wind"></i> Vento NO 6 nodi
                </div>
            </div>
        </div>

        <!-- Navigazione a Schede / Tab (Senza Check-in) -->
        <div class="flex bg-slate-200 p-1 rounded-xl text-xs font-bold text-slate-600 gap-1 shadow-inner">
            <button onclick="switchTab('poi')" id="tab-poi" class="tab-btn flex-1 py-2.5 rounded-lg bg-white text-slate-900 shadow">Punti d'Interesse</button>
            <button onclick="switchTab('guida')" id="tab-guida" class="tab-btn flex-1 py-2.5 rounded-lg hover:text-slate-900">Guida Barca</button>
            <button onclick="switchTab('regole')" id="tab-regole" class="tab-btn flex-1 py-2.5 rounded-lg hover:text-slate-900">Regole Mare</button>
        </div>

        <!-- SEZIONE 1: MAPPA + SCHEDE FOTOGRAFICHE PUNTI D'INTERESSE -->
        <div id="sec-poi" class="tab-content space-y-4">
            <!-- Mappa Interattiva -->
            <div class="bg-white p-4 rounded-2xl shadow-md border border-slate-200">
                <h3 class="font-bold text-slate-800 mb-3 flex items-center gap-2 text-sm">
                    <i class="fa-solid fa-map-location-dot text-cyan-600"></i> Mappa Calette & Grotte
                </h3>
                <div id="map" class="h-64 rounded-xl border border-slate-200 shadow-inner z-0"></div>
            </div>

            <!-- Elenco Schede Foto Punti di Interesse -->
            <div class="space-y-3">
                <h3 class="font-bold text-slate-800 text-sm flex items-center gap-2 px-1">
                    <i class="fa-solid fa-camera text-cyan-600"></i> Luoghi da Non Perdere
                </h3>
                <div id="poi-cards-container" class="space-y-4">
                    <!-- Popolato dinamicamente da data.json -->
                </div>
            </div>
        </div>

        <!-- SEZIONE 2: GUIDA SPECIFICA BARCA -->
        <div id="sec-guida" class="tab-content hidden space-y-3">
            <div class="bg-white p-5 rounded-2xl shadow-md border border-slate-200 space-y-4">
                <h3 class="font-bold text-slate-800 flex items-center gap-2 border-b pb-2 text-sm">
                    <i class="fa-solid fa-compass text-cyan-600"></i> Istruzioni Imbarcazione
                </h3>
                <div id="guida-barca-lista" class="space-y-3 text-xs">
                    <!-- Dinamico -->
                </div>
            </div>
        </div>

        <!-- SEZIONE 3: REGOLE NAVIGAZIONE GENERALI -->
        <div id="sec-regole" class="tab-content hidden space-y-3">
            <div class="bg-white p-5 rounded-2xl shadow-md border border-slate-200 space-y-3">
                <h3 class="font-bold text-slate-800 flex items-center gap-2 border-b pb-2 text-sm">
                    <i class="fa-solid fa-shield-halved text-cyan-600"></i> Normative Mare & Sicurezza
                </h3>
                <ul id="regole-generali-lista" class="text-xs space-y-3 text-slate-600">
                    <!-- Dinamico -->
                </ul>
            </div>
        </div>

    </main>

    <footer class="mt-8 text-center pb-6">
        <a href="admin.html" class="text-xs text-slate-400 hover:text-cyan-600 transition flex items-center justify-center gap-1">
            <i class="fa-solid fa-lock"></i> Area Riservata Gestore NAUTICOVI
        </a>
    </footer>

    <script>
        let map;

        function switchTab(tab) {
            document.querySelectorAll('.tab-content').forEach(el => el.classList.add('hidden'));
            document.querySelectorAll('.tab-btn').forEach(el => {
                el.classList.remove('bg-white', 'text-slate-900', 'shadow');
                el.classList.add('hover:text-slate-900');
            });
            document.getElementById('sec-' + tab).classList.remove('hidden');
            document.getElementById('tab-' + tab).classList.add('bg-white', 'text-slate-900', 'shadow');

            if(tab === 'poi' && map) {
                setTimeout(() => map.invalidateSize(), 200);
            }
        }

        async function loadAppData() {
            try {
                const response = await fetch('data.json');
                const data = await response.json();

                const urlParams = new URLSearchParams(window.location.search);
                const clientId = urlParams.get('id') || '1';

                const noleggio = data.noleggi.find(n => n.id === clientId) || data.noleggi[0];

                // 1. Dati Cliente
                document.getElementById('welcome-nome').innerText = `Benvenuto, ${noleggio.cliente}!`;
                document.getElementById('welcome-barca').innerText = noleggio.barca;

                // 2. Guida Barca
                const guidaBox = document.getElementById('guida-barca-lista');
                guidaBox.innerHTML = '';
                noleggio.regole_barca.forEach((regola, index) => {
                    guidaBox.innerHTML += `
                        <div class="p-3 bg-slate-50 rounded-xl border border-slate-200 flex items-start gap-3">
                            <div class="bg-cyan-600 text-white p-2 rounded-lg font-bold text-xs">${index + 1}</div>
                            <p class="text-slate-700 font-medium">${regola}</p>
                        </div>
                    `;
                });

                // 3. Regole Mare
                const regoleBox = document.getElementById('regole-generali-lista');
                regoleBox.innerHTML = '';
                data.regole_navigazione_generali.forEach(regola => {
                    regoleBox.innerHTML += `
                        <li class="flex items-start gap-2.5">
                            <i class="fa-solid fa-circle-check text-emerald-500 text-sm mt-0.5"></i>
                            <span>${regola}</span>
                        </li>
                    `;
                });

                // 4. Mappa & Schede Foto POI
                map = L.map('map').setView([39.8700, 15.7750], 13);
                L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', { attribution: '© OpenStreetMap' }).addTo(map);

                const cardsContainer = document.getElementById('poi-cards-container');
                cardsContainer.innerHTML = '';

                data.punti_interesse.forEach(poi => {
                    // Marker Mappa
                    L.marker([poi.lat, poi.lng]).addTo(map)
                        .bindPopup(`<b>${poi.nome}</b><br><span style="font-size:11px">${poi.categoria}</span>`);

                    // Card con Foto e Descrizione
                    cardsContainer.innerHTML += `
                        <div class="bg-white rounded-2xl overflow-hidden shadow-md border border-slate-200">
                            <img src="${poi.immagine}" alt="${poi.nome}" class="w-full h-44 object-cover">
                            <div class="p-4 space-y-1.5">
                                <span class="bg-cyan-100 text-cyan-800 text-[10px] font-bold px-2.5 py-0.5 rounded-full uppercase">${poi.categoria}</span>
                                <h4 class="font-bold text-slate-800 text-base">${poi.nome}</h4>
                                <p class="text-xs text-slate-600 leading-relaxed">${poi.descrizione}</p>
                            </div>
                        </div>
                    `;
                });

            } catch (err) {
                console.error("Errore caricamento dati data.json", err);
            }
        }

        loadAppData();
    </script>
</body>
</html>
