        const map = L.map('map').setView([39.8700, 15.7750], 13);

        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
            attribution: '© OpenStreetMap'
        }).addTo(map);

        // Punti d'interesse predefiniti
        const poiList = JSON.parse(localStorage.getItem('nauticovi_poi')) || [
            { nome: 'Isola di Dino & Grotta Azzurra', desc: 'Acque cristalline e grotta famosa per i riflessi blu.', lat: 39.8731, lng: 15.7735 },
            { nome: 'Grotta del Leone', desc: 'Roccia a forma di leone sdraiato e fondale ideale per snorkeling.', lat: 39.8695, lng: 15.7720 },
