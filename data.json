1. Codice del Pannello Gestionale CRM & Export Fatture
Questo modulo ti permette di inserire rapidamente i dati dei clienti e generare il file pronto per Fatture in Cloud (o sincronizzarlo su Google Sheets).   
JPG

Salva questo codice come admin.html per testare subito l'interfaccia nel tuo browser:

HTML
<!DOCTYPE html>
<html lang="it">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>NAUTICOVI - CRM & Gestionale Noleggio</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
</head>
<body class="bg-gray-100 text-gray-800 font-sans">

    <!-- Header / Navbar -->
    <nav class="bg-slate-900 text-white p-4 shadow-lg flex justify-between items-center">
        <div class="flex items-center space-x-3">
            <span class="text-xl font-bold tracking-wider text-cyan-400">NAUTICOVI</span>
            <span class="text-xs bg-cyan-900 text-cyan-200 px-2 py-1 rounded">CRM Admin</span>
        </div>
        <div class="text-sm text-gray-300">Praia a Mare (CS)</div>
    </nav>

    <div class="max-w-7xl mx-auto p-6 grid grid-cols-1 lg:grid-cols-3 gap-6">

        <!-- Form Inserimento Cliente & Noleggio -->
        <div class="lg:col-span-1 bg-white p-6 rounded-xl shadow-md border border-gray-200">
            <h2 class="text-lg font-bold text-slate-800 mb-4 flex items-center gap-2">
                <i class="fa-solid fa-user-plus text-cyan-600"></i> Nuovo Noleggio
            </h2>

            <form id="crmForm" class="space-y-4">
                <div>
                    <label class="block text-xs font-semibold text-gray-600 uppercase">Nome e Cognome / Ragione Sociale</label>
                    <input type="text" id="nome" required class="w-full mt-1 p-2 border rounded focus:ring-2 focus:ring-cyan-500 outline-none">
                </div>

                <div class="grid grid-cols-2 gap-2">
                    <div>
                        <label class="block text-xs font-semibold text-gray-600 uppercase">Cod. Fiscale / P.IVA</label>
                        <input type="text" id="cf_piva" required class="w-full mt-1 p-2 border rounded focus:ring-2 focus:ring-cyan-500 outline-none">
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-gray-600 uppercase">Telefono / WhatsApp</label>
                        <input type="tel" id="telefono" required class="w-full mt-1 p-2 border rounded focus:ring-2 focus:ring-cyan-500 outline-none">
                    </div>
                </div>

                <div>
                    <label class="block text-xs font-semibold text-gray-600 uppercase">Email (per Fattura)</label>
                    <input type="email" id="email" required class="w-full mt-1 p-2 border rounded focus:ring-2 focus:ring-cyan-500 outline-none">
                </div>

                <div class="grid grid-cols-2 gap-2">
                    <div>
                        <label class="block text-xs font-semibold text-gray-600 uppercase">Barca Assegnata</label>
                        <select id="barca" class="w-full mt-1 p-2 border rounded focus:ring-2 focus:ring-cyan-500 outline-none bg-white">
                            <option>Marlin 1 (Senza Patente)</option>
                            <option>Marlin 2 (Senza Patente)</option>
                            <option>Poseidon 3 (Con Skipper)</option>
                        </select>
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-gray-600 uppercase">Importo (€)</label>
                        <input type="number" id="importo" required class="w-full mt-1 p-2 border rounded focus:ring-2 focus:ring-cyan-500 outline-none">
                    </div>
                </div>

                <div>
                    <label class="block text-xs font-semibold text-gray-600 uppercase">Data Noleggio</label>
                    <input type="date" id="data_noleggio" required class="w-full mt-1 p-2 border rounded focus:ring-2 focus:ring-cyan-500 outline-none">
                </div>

                <button type="submit" class="w-full bg-cyan-600 hover:bg-cyan-700 text-white font-bold py-2.5 rounded shadow transition flex justify-center items-center gap-2">
                    <i class="fa-solid fa-file-csv"></i> Salva ed Esporta per Fatture in Cloud
                </button>
            </form>
        </div>

        <!-- Registro Clienti e Prenotazioni -->
        <div class="lg:col-span-2 bg-white p-6 rounded-xl shadow-md border border-gray-200">
            <div class="flex justify-between items-center mb-4">
                <h2 class="text-lg font-bold text-slate-800 flex items-center gap-2">
                    <i class="fa-solid fa-list-check text-cyan-600"></i> Registro Clienti
                </h2>
                <button onclick="exportCSV()" class="bg-emerald-600 hover:bg-emerald-700 text-white text-xs px-3 py-2 rounded font-semibold flex items-center gap-1 shadow">
                    <i class="fa-solid fa-file-excel"></i> Scarica CSV Fatture in Cloud
                </button>
            </div>

            <div class="overflow-x-auto">
                <table class="w-full text-left border-collapse text-sm">
                    <thead>
                        <tr class="bg-slate-100 text-slate-700 border-b">
                            <th class="p-3">Cliente</th>
                            <th class="p-3">CF / P.IVA</th>
                            <th class="p-3">Barca</th>
                            <th class="p-3">Data</th>
                            <th class="p-3">Importo</th>
                            <th class="p-3">Azienda/Fattura</th>
                        </tr>
                    </thead>
                    <tbody id="clientiTable" class="divide-y divide-gray-100">
                        <!-- Popolato via JavaScript -->
                    </tbody>
                </table>
            </div>
        </div>

    </div>

    <script>
        let clienti = JSON.parse(localStorage.getItem('nauticovi_clienti')) || [];

        function renderTable() {
            const tbody = document.getElementById('clientiTable');
            tbody.innerHTML = '';
            clienti.forEach((c, index) => {
                tbody.innerHTML += `
                    <tr class="hover:bg-slate-50">
                        <td class="p-3 font-semibold">${c.nome}<br><span class="text-xs font-normal text-gray-500">${c.email}</span></td>
                        <td class="p-3 text-xs font-mono">${c.cf_piva}</td>
                        <td class="p-3 text-xs">${c.barca}</td>
                        <td class="p-3 text-xs">${c.data_noleggio}</td>
                        <td class="p-3 font-bold text-emerald-600">€${c.importo}</td>
                        <td class="p-3">
                            <span class="bg-blue-100 text-blue-800 text-xs px-2 py-1 rounded">Pronto Import</span>
                        </td>
                    </tr>
                `;
            });
        }

        document.getElementById('crmForm').addEventListener('submit', function(e) {
            e.preventDefault();
            const nuovo = {
                nome: document.getElementById('nome').value,
                cf_piva: document.getElementById('cf_piva').value,
                telefono: document.getElementById('telefono').value,
                email: document.getElementById('email').value,
                barca: document.getElementById('barca').value,
                importo: document.getElementById('importo').value,
                data_noleggio: document.getElementById('data_noleggio').value
            };
            clienti.push(nuovo);
            localStorage.setItem('nauticovi_clienti', JSON.stringify(clienti));
            renderTable();
            this.reset();
        });

        function exportCSV() {
            let csv = "Nome,CodiceFiscale_PIVA,Email,Telefono,Descrizione,Importo,Data\n";
            clienti.forEach(c => {
                csv += `"${c.nome}","${c.cf_piva}","${c.email}","${c.telefono}","Noleggio barca ${c.barca}",${c.importo},"${c.data_noleggio}"\n`;
            });
            const blob = new Blob([csv], { type: 'text/csv' });
            const url = window.URL.createObjectURL(blob);
            const a = document.createElement('a');
            a.setAttribute('href', url);
            a.setAttribute('download', 'import_fatture_in_cloud_nauticovi.csv');
            a.click();
        }

        renderTable();
    </script>
</body>
</html>
